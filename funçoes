
let tarefas = [];


let adicionarTarefa = function (tarefa) {
  tarefas.push({ nome: tarefa, concluida: false });
  console.log(` Tarefa adicionada: ${tarefa}`);
};


let listarTarefas = () => {
  console.log("\n Lista de Tarefas:");
  tarefas.forEach((tarefa, index) => {
    console.log(
      `${index} - ${tarefa.nome} ${tarefa.concluida ? "(Concluída)" : ""}`
    );
  });
};


function processarTarefa(indice, callback) {
  if (indice >= 0 && indice < tarefas.length) {
    callback(indice);
  } else {
    console.log(" Índice inválido!");
  }
}


let removerTarefa = (i) => {
  console.log(` Tarefa removida: ${tarefas[i].nome}`);
  tarefas.splice(i, 1);
};

let atualizarTarefa = (i) => {
  let novaTarefa = prompt("Digite o novo nome da tarefa:");
  console.log(` Tarefa atualizada: ${tarefas[i].nome} → ${novaTarefa}`);
  tarefas[i].nome = novaTarefa;
};

let concluirTarefa = (i) => {
  tarefas[i].concluida = true;
  console.log(` Tarefa concluída: ${tarefas[i].nome}`);
};


let opcao;
do {
  opcao = prompt(
    "Escolha uma opção:\n1 - Adicionar Tarefa\n2 - Listar Tarefas\n3 - Remover Tarefa\n4 - Atualizar Tarefa\n5 - Concluir Tarefa\n0 - Sair"
  );

  switch (opcao) {
    case "1":
      let tarefa = prompt("Digite a tarefa:");
      adicionarTarefa(tarefa);
      break;

    case "2":
      listarTarefas();
      break;

    case "3":
      listarTarefas();
      let iRemover = parseInt(prompt("Digite o índice da tarefa para remover:"));
      processarTarefa(iRemover, removerTarefa);
      break;

    case "4":
      listarTarefas();
      let iAtualizar = parseInt(prompt("Digite o índice da tarefa para atualizar:"));
      processarTarefa(iAtualizar, atualizarTarefa);
      break;

    case "5":
      listarTarefas();
      let iConcluir = parseInt(prompt("Digite o índice da tarefa para concluir:"));
      processarTarefa(iConcluir, concluirTarefa);
      break;

    case "0":
      console.log("Saindo do programa...");
      break;

    default:
      console.log(" Opção inválida!");
  }
} while (opcao !== "0");
